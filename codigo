# Projeto: Calculo de determinantes (matriz 2x2 e 3x3)
# Regra de negocio: se o determinante for diferente de zero, o acesso e liberado.

def determinante_2x2(m):
    # Multiplica a diagonal principal e subtrai a multiplicacao da outra diagonal
    return m[0][0] * m[1][1] - m[0][1] * m[1][0]


def determinante_3x3(m):
    # Regra de Sarrus
    principais = (m[0][0] * m[1][1] * m[2][2]
                  + m[0][1] * m[1][2] * m[2][0]
                  + m[0][2] * m[1][0] * m[2][1])
    secundarias = (m[0][2] * m[1][1] * m[2][0]
                   + m[0][0] * m[1][2] * m[2][1]
                   + m[0][1] * m[1][0] * m[2][2])
    return principais - secundarias


def verificar_acesso(det):
    # Regra de negocio: determinante diferente de zero libera o acesso
    if det != 0:
        return "ACESSO LIBERADO"
    return "ACESSO NEGADO"


# Matrizes de teste
matriz_a = [[4, 3],
            [6, 8]]

matriz_b = [[1, 2, 3],
            [4, 5, 6],
            [7, 8, 9]]

det_a = determinante_2x2(matriz_a)
det_b = determinante_3x3(matriz_b)

print("Matriz 2x2 -> determinante =", det_a, "->", verificar_acesso(det_a))
print("Matriz 3x3 -> determinante =", det_b, "->", verificar_acesso(det_b))
