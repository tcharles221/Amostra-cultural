estoque = {
    "Caderno": {"preco": 15.90, "quantidade": 20},
    "Caneta": {"preco": 2.50, "quantidade": 3},
    "Mochila": {"preco": 89.99, "quantidade": 5},
    "Lapis": {"preco": 1.20, "quantidade": 2},
    "Borracha": {"preco": 1.80, "quantidade": 15},
}

LIMITE_MINIMO = 5  # abaixo disso o produto precisa ser reposto


def mostrar_estoque(produtos):
    print("=== ESTOQUE ATUAL ===")
    for nome, dados in produtos.items():
        print(f"{nome}: {dados['quantidade']} unidades - R$ {dados['preco']:.2f} cada")


def produtos_em_falta(produtos, limite):
    # Guarda numa lista os produtos com pouca quantidade
    lista = []
    for nome, dados in produtos.items():
        if dados["quantidade"] < limite:
            lista.append(nome)
    return lista


def valor_total(produtos):
    # Soma preco x quantidade de cada produto
    total = 0
    for dados in produtos.values():
        total += dados["preco"] * dados["quantidade"]
    return total


def vender(produtos, nome, quantidade):
    # Regra: so vende se tiver quantidade suficiente no estoque
    if nome not in produtos:
        print(f"Produto '{nome}' nao existe.")
    elif produtos[nome]["quantidade"] < quantidade:
        print(f"Venda negada: so tem {produtos[nome]['quantidade']} de {nome}.")
    else:
        produtos[nome]["quantidade"] -= quantidade
        print(f"Venda realizada: {quantidade} de {nome}.")


mostrar_estoque(estoque)

print("\nValor total em estoque: R$ %.2f" % valor_total(estoque))

print("\n=== SIMULANDO VENDAS ===")
vender(estoque, "Mochila", 2)
vender(estoque, "Caneta", 10)

print("\n=== PRODUTOS PARA REPOR ===")
for produto in produtos_em_falta(estoque, LIMITE_MINIMO):
    print("- " + produto)
